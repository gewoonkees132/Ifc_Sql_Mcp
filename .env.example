# Copy to .env to override the development defaults. .env is git-ignored: never commit it.
# docker compose reads this file directly; the Makefile exports it to uv/pytest.
# Write values without quotes (make would keep them literally).

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=ifc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ifc
POSTGRES_PORT=5432

# Application (src/ifc_sql_mcp/config.py). Keep the URL in step with the values above.
IFC_SQL_DATABASE_URL=postgresql+psycopg://ifc:change-me@localhost:5432/ifc
# Password `make migrate` gives the read-only ifc_reader role. `ifc-sql serve` (the MCP
# server) connects only as ifc_reader: it takes host, port and database from the URL
# above and ignores its user and password.
IFC_SQL_READER_PASSWORD=change-me-too
IFC_SQL_LOG_LEVEL=INFO

# Or, with no PostgreSQL server: an embedded PostgreSQL 16 in a folder of yours, for one
# user (uv sync --extra embedded; docs/adr/0013-embedded-postgresql.md, SECURITY.md).
# Set this or IFC_SQL_DATABASE_URL, not both.
# IFC_SQL_DATA_DIR=/home/you/.local/share/ifc-sql
