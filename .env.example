# Copy to .env to override the development defaults. .env is git-ignored: never commit it.
# docker compose reads this file directly; the Makefile exports it to uv/pytest.
# Write values without quotes (make would keep them literally).

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=ifc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ifc
POSTGRES_PORT=5432

# Application (src/ifc_sql_mcp/config.py). Keep the URL in step with the values above.
IFC_SQL_DATABASE_URL=postgresql+psycopg://ifc:change-me@localhost:5432/ifc
# Password `make migrate` gives the read-only ifc_reader role (used by the MCP server).
IFC_SQL_READER_PASSWORD=change-me-too
IFC_SQL_LOG_LEVEL=INFO
